	<!-- organize -->
	<string name="organize">Organize this folder</string>
	<string name="organize_summary">Number the seasons and name the episodes the way the library reads them</string>
	<string name="organize_explain">The folders inside get numbered in order (01 - Name) and the videos take the folder\'s name with their episode number (Name - E01). Files without a number are left alone. Nothing moves until you confirm.</string>
